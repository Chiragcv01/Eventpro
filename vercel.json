{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/site?view=home"
    },
    {
      "source": "/download",
      "destination": "/api/site?view=download"
    },
    {
      "source": "/doctors",
      "destination": "/api/site?view=doctors"
    },
    {
      "source": "/events",
      "destination": "/api/site?view=events"
    },
    {
      "source": "/blog",
      "destination": "/api/site?view=blog"
    },
    {
      "source": "/blog/rss.xml",
      "destination": "/api/site?view=rss"
    },
    {
      "source": "/blog/:slug",
      "destination": "/api/site?view=post&slug=:slug"
    },
    {
      "source": "/privacy",
      "destination": "/api/site?view=privacy"
    },
    {
      "source": "/delete-account",
      "destination": "/api/site?view=delete"
    },
    {
      "source": "/terms",
      "destination": "/api/site?view=terms"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/site?view=sitemap"
    },
    {
      "source": "/robots.txt",
      "destination": "/api/site?view=robots"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    },
    {
      "source": "/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/version.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/download/(.*)\\.apk",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/vnd.android.package-archive"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"SabManage.apk\""
        },
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ],
  "regions": [
    "bom1"
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "eventpro-os.vercel.app"
        }
      ],
      "destination": "https://sabmanage.com/:path*",
      "permanent": true
    }
  ]
}
